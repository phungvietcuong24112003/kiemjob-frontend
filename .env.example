# KIEMJOB FRONTEND - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Sao chép file này thành .env để chạy local, hoặc inject trong CI/CD khi build lên S3/CloudFront.
# ===================================================================

# Base URL của Backend API
# Chạy cục bộ: /api (được Vite reverse proxy sang http://localhost:8080)
# Môi trường Production sau CloudFront: /api (nếu CloudFront route /api sang ALB) hoặc https://api.kiemjob.com/api
VITE_API_URL=/api

# WebSocket URL kết nối STOMP
# Chạy cục bộ: ws://localhost:8080/ws
# Production HTTPS: wss://api.kiemjob.com/ws
VITE_WS_URL=ws://localhost:8080/ws

